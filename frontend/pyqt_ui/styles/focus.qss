/* ===== Focus Time / Pomodoro ===== */

#focusPage {
    background-color: #07131d;
}

#metricsPanel,
#forestPanel {
    background-color: #0c1a26;
    border-radius: 18px;
}

#focusCenterPanel {
    background-color: #091723;
    border-radius: 22px;
}

#panelHeader {
    color: #7dcad0;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    padding-bottom: 4px;
}

/* --- métricas --- */

#metricCard {
    background-color: #10212e;
    border-radius: 14px;
}

#metricTitle {
    color: #78bfc5;
    font-size: 11px;
    font-weight: 700;
}

#metricValue {
    color: #f1feff;
    font-size: 22px;
    font-weight: 700;
}

#statusChip {
    background-color: #102736;
    color: #9adce2;
    border-radius: 10px;
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 700;
}

#statusChip[running="true"] {
    background-color: #0ec7cf;
    color: #031116;
}

/* --- centro / timer --- */

#focusModeLabel {
    color: #77b8be;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 2px;
}

#levelLabel {
    color: #d8fbff;
    font-size: 16px;
    font-weight: 700;
}

#xpBar {
    background-color: #122433;
    border: none;
    border-radius: 7px;
    height: 14px;
}

#xpBar::chunk {
    background-color: #00F5FF;
    border-radius: 7px;
}

#xpLabel {
    color: #00F5FF;
    font-size: 13px;
    font-weight: 700;
}

#minutesCaption {
    color: #8fd8df;
    font-size: 13px;
    font-weight: 700;
}

#minutesInput {
    background-color: #102434;
    border: 2px solid #1fd6df;
    border-radius: 8px;
    color: #efffff;
    font-size: 16px;
    font-weight: 700;
    padding: 6px;
}

#minutesInput:disabled {
    border-color: #234450;
    color: #6f939a;
}

#primaryButton {
    background-color: #0ec7cf;
    border: 2px solid #b7fbff;
    border-radius: 14px;
    color: #031116;
    font-size: 15px;
    font-weight: 700;
    padding: 12px 26px;
}

#primaryButton:hover {
    background-color: #09aab1;
}

#resetButton {
    background-color: #102434;
    border: 2px solid #3f6674;
    border-radius: 14px;
    color: #f3fcff;
    font-size: 15px;
    font-weight: 700;
    padding: 12px 22px;
}

#resetButton:hover {
    background-color: #163244;
}

/* --- floresta / jardim --- */

#forestMessage {
    color: #d9fcff;
    font-size: 13px;
}

#forestGrid {
    background-color: #10212e;
    border-radius: 14px;
    padding: 10px;
}

/* Cada árvore fica dentro de um "canteiro" pequeno, não solta na tela */
#treeSlot {
    background-color: #0c1c28;
    border: 1px solid #1c3644;
    border-radius: 12px;
}

#treeSlot:hover {
    border-color: #00F5FF;
    background-color: #0f2330;
}

#treeIcon {
    background-color: transparent;
}